#include<stdio.h>
void main()
{
int a,b,c,d,e,f,g,j,i,q,w,t,y;
printf("\n Enter the value of a:");
scanf("%d",&a);
printf("\n Enter the value of b:");
scanf("%d",&b);
printf("\n Enter the value of c:");
scanf("%d",&c);
printf("\n Enter the value of d:");
scanf("%d",&d);
printf("\n Enter the value of e:");
scanf("%d",&e);
printf("\n Enter the value of f:");
scanf("%d",&f);
printf("\n Enter the value of g:");
scanf("%d",&g);
printf("\n Enter the value of j:");
scanf("%d",&j);
printf("\n Enter the value of i:");
scanf("%d",&i);
q=a+b*c+(d*e)+f*g;
w=a/b*c-b+a*d/3;
t=a+++b---a;
y=(i++)+(i--);
printf("\n a+b*c+(d*e)+f*g = %d",q);
printf("\n a/b*c-b+a*d/3 = %d",w);
printf("\n a+++b---a = %d",t);
printf("\n (i++)+(i--) = %d",y);
}
