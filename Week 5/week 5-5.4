  #include<stdio.h>
void main()
{
int o1,o2,r;
char o;
printf("\n Enter operator :");
scanf("%c",&o);
printf("\n Enter two operands :");
scanf("%d%d",&o1,&o2);
switch(o)
{
case '+':
r=o1+o2;
printf("\n result = %d",r);
break;
case '-':
r=o1-o2;
printf("\n Result = %d",r);
break;
case '*':
r=o1*o2;
printf("\n Result = %d",r);
break;
case '/':
r=o1/-o2;
printf("\n Result = %d",r);
break;
}
}

